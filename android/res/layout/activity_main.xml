<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#111827"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/txtAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Project-X-Nano"
            android:textColor="@color/text_white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnQuickLock"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Lock"
            android:textSize="12sp"
            android:textColor="#f87171"
            android:background="#1e293b"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnSwitchPC"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Server"
            android:textSize="12sp"
            android:textColor="@color/accent_blue"
            android:background="#1e293b"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Reload"
            android:textSize="12sp"
            android:textColor="@color/text_white"
            android:background="#1e293b" />
    </LinearLayout>

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_below="@id/topBar"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/accent_blue"
        android:visibility="gone" />

    <!-- Fullscreen Controller WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/progressBar"
        android:visibility="gone" />

    <!-- Setup / Connect Dialog Card -->
    <ScrollView
        android:id="@+id/setupView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PC Controller"
                android:textColor="@color/text_white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connect to your Windows PC or Cloud Fleet"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:layout_marginBottom="28dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Server URL:"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/editServerUrl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#1e293b"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_muted"
                android:hint="http://192.168.1.50:8765"
                android:singleLine="true"
                android:inputType="textUri"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Admin Password:"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/editPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#1e293b"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_muted"
                android:hint="mexxz@2007"
                android:singleLine="true"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#2563eb"
                android:textColor="@color/text_white"
                android:text="Connect to PC"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tips for Remote Access:\n- Same Wi-Fi: Enter your PC IP (e.g. http://192.168.1.x:8765)\n- Anywhere in World: Use your Tailscale IP, Cloudflare Tunnel link, or Render URL."
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
